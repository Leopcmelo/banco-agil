# Copie para .env e preencha. O arquivo .env NUNCA é versionado.

# --- LLM (obrigatório) ---
# Provedor do modelo: anthropic | google
# O resto do sistema não sabe qual está atrás — é escolha de operação.
BANCO_AGIL_PROVEDOR=anthropic

# --- Anthropic (se BANCO_AGIL_PROVEDOR=anthropic) ---
# Chave: https://console.anthropic.com/settings/keys
# Gere uma chave DE WORKSPACE. Uma chave vinculada à identidade exige o header
# anthropic-workspace-id em toda chamada (preencha ANTHROPIC_WORKSPACE_ID).
ANTHROPIC_API_KEY=
BANCO_AGIL_MODELO_ANTHROPIC=claude-opus-5
# Só para chaves identity-linked. Formato wrkspc_...
ANTHROPIC_WORKSPACE_ID=

# --- Google Gemini (se BANCO_AGIL_PROVEDOR=google) ---
# Chave: https://aistudio.google.com/apikey
GOOGLE_API_KEY=
BANCO_AGIL_MODELO=gemini-3.6-flash

# Teto de tokens por resposta. Folgado de propósito: nos modelos com raciocínio
# ligado por padrão, este limite cobre raciocínio E texto juntos.
BANCO_AGIL_MAX_TOKENS=8192

# Temperatura. Deixe VAZIO: gemini-3.x ignora e avisa a cada chamada, e o
# Claude Opus 5 recusa a requisição com 400. Preencha apenas se apontar o
# projeto para um modelo que aceite amostragem (ex.: gemini-2.5).
BANCO_AGIL_TEMPERATURA=

# --- Dados ---
# Diretório dos CSVs. Útil para apontar para uma cópia em testes manuais.
BANCO_AGIL_DATA_DIR=data

# --- Câmbio (ADR-005) ---
# Fonte primária (AwesomeAPI) e fallback. Nenhuma exige chave.
BANCO_AGIL_CAMBIO_URL_PRIMARIA=https://economia.awesomeapi.com.br/json/last
BANCO_AGIL_CAMBIO_URL_FALLBACK=https://open.er-api.com/v6/latest
BANCO_AGIL_CAMBIO_TIMEOUT=5

# --- Logging ---
BANCO_AGIL_LOG_LEVEL=INFO
